<idea-plugin>
    <id>com.github.pallad42.powder</id>
    <name>Powder</name>
    <vendor url="https://github.com/pallad42/powder-jetbrains">pallad42</vendor>

    <change-notes><![CDATA[
        <p><b>0.1.0</b> - first release.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="powder-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="powder" path="/themes/Powder.theme.json"/>
        <bundledColorScheme id="Powder" path="/themes/Powder.xml"/>
        <notificationGroup id="Powder" displayType="BALLOON"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.pallad42.powder.PowderAppListener" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="com.github.pallad42.powder.PowderThemeListener" topic="com.intellij.ide.ui.LafManagerListener"/>
    </applicationListeners>
</idea-plugin>
